# Required
OPENAI_API_KEY=your-key-here

# Optional (defaults shown)
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Backend: leave BACKEND_URL empty and `streamlit run app.py` starts the FastAPI backend itself.
# Set BACKEND_URL (for example http://localhost:8000) only to use a backend that is already running.
BACKEND_URL=
BACKEND_PORT=8000